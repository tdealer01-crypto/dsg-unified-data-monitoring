# Supabase Configuration for Docker
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0

# Monitoring Configuration
MONITORING_CHECK_INTERVAL=300000
HEALTH_CHECK_INTERVAL=600000
DIVERGENCE_CHECK_INTERVAL=900000

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_SCHEMA_VALIDATION=true
ENABLE_DATA_SYNC_MONITORING=true
ENABLE_HEALTH_CHECKS=true
ENABLE_CROSS_REPO_VALIDATION=true
