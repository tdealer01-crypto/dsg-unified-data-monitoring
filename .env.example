# PRODUCTION AUTHORITY: Azure only. Vercel/Render/Railway/AWS/GCP are retired.
# Runtime secrets are stored in Azure Key Vault and resolved through the Azure
# service Managed Identity. GitHub OIDC is bootstrap/rotation authority only.
# This committed file is a names-only catalog, never a production value source.
PORT=3000
# Non-secret Supabase project API URL for the exact observed database.
SUPABASE_URL=
# SECRET: server-side service-role credential; Azure Key Vault only.
SUPABASE_SERVICE_ROLE_KEY=
# Existing public.organizations.id from the same Supabase project; verify live.
MONITORING_ORG_ID=
# SECRET: generated high-entropy bearer key for this monitoring API.
# This value is not issued by Supabase; create/rotate it in Azure Key Vault.
MONITORING_API_KEY=
# Optional SECRET. Enables authenticated visibility of private canonical repositories.
DSG_GITHUB_AUTOMATION_TOKEN=
# Optional non-secret HTTPS endpoint; required for the closed post-deploy handoff.
DSG_CONTROL_PLANE_POST_DEPLOY_URL=
# Optional SECRET shared with Control Plane; Azure Key Vault only.
DSG_CONTROL_PLANE_POST_DEPLOY_SECRET=
