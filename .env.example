# PRODUCTION AUTHORITY: Azure only. Vercel/Render/Railway/AWS/GCP are retired.
# Runtime secrets are stored in Azure Key Vault and resolved through the Azure
# service Managed Identity. GitHub OIDC is bootstrap/rotation authority only.
# This committed file is a names-only catalog, never a production value source.
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONITORING_ORG_ID=
MONITORING_API_KEY=
# Optional. Enables authenticated visibility of private canonical repositories.
DSG_GITHUB_AUTOMATION_TOKEN=
# Optional for basic monitoring; required for the closed post-deploy handoff endpoint.
DSG_CONTROL_PLANE_POST_DEPLOY_URL=
DSG_CONTROL_PLANE_POST_DEPLOY_SECRET=
